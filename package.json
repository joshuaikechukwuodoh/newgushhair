{
  "name": "gush2-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend && npm run build --prefix admin && node scripts/copy-dist.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin",
    "dev:backend": "npm run dev --prefix backend",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix admin"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@supabase/supabase-js": "^2.101.1",
    "@trpc/server": "^11.16.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "typescript": "~5.8.2"
  }
}
