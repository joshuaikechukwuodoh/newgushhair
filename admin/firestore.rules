rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - price: number (required)
    //   - description: string
    //   - imageUrl: string
    //   - category: string (enum: Wig, Bundle, Closure, Other)
    //   - createdAt: timestamp
    //
    // Collection: orders
    // Document ID: auto-generated
    // Fields:
    //   - customerName: string (required)
    //   - productName: string (required)
    //   - status: string (enum: Pending, Delivered, Cancelled)
    //   - createdAt: timestamp
    //
    // Collection: settings
    // Document ID: main
    // Fields:
    //   - siteName: string
    //   - contactInfo: string
    //   - heroImage: string
    //   - bannerText: string
    //   - advertText: string
    //
    // Collection: users
    // Document ID: uid
    // Fields:
    //   - uid: string
    //   - email: string
    //   - role: string (enum: admin, customer)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "joshuaokibe@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             data.category in ['Wig', 'Bundle', 'Closure', 'Other'] &&
             (!('description' in data) || (data.description is string && data.description.size() < 1000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 500));
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 &&
             data.productName is string && data.productName.size() > 0 &&
             data.status in ['Pending', 'Delivered', 'Cancelled'];
    }

    function isValidSettings(data) {
      return (!('siteName' in data) || (data.siteName is string && data.siteName.size() < 50)) &&
             (!('contactInfo' in data) || (data.contactInfo is string && data.contactInfo.size() < 200));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (isOwner(userId) && request.resource.data.role == 'customer' || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) && request.resource.data.role == resource.data.role || isAdmin());
    }

    match /products/{productId} {
      allow read: if true; // Publicly readable
      allow create, update, delete: if isAdmin() && isValidProduct(request.resource.data);
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if true; // Anyone can place an order for now (mock)
      allow update, delete: if isAdmin() && isValidOrder(request.resource.data);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
